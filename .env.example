# Copy this file to .env and fill in your real values.
# Never commit the real .env file -- it's already excluded via .gitignore.

# Required -- primary LLM provider
GROQ_API_KEY=your-groq-key-here

# Optional but recommended -- automatic fallback if Groq rate-limits or errors.
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# Optional -- override the default Groq model
GROQ_MODEL=llama-3.3-70b-versatile

# Required -- your hosted MCP server (the separate multi-api-mcp-server repo/deploy)
MCP_SERVER_URL=https://your-mcp-server.onrender.com/mcp

# Optional -- only needed if the hosted MCP server has auth enabled
MCP_AUTH_TOKEN=

# Optional -- port this chatbot listens on (defaults to 5070)
IMMERSIVE_PORT=5070
